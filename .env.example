# Postgres connection string. Local: postgres://postgres:postgres@localhost:5432/alan_run_inspector
DATABASE_URL=

# Better Auth session secret, at least 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Base URL Better Auth uses to build links and check origins. Local: http://localhost:3000
BETTER_AUTH_URL=

# "mock" (default: recorded fixtures, no key needed) or "live" (real AI Gateway calls)
AI_MODE=mock

# "local" (files under .data/, in-process queue) or "vercel" (Vercel Blob + Vercel Queues)
INFRA_MODE=local

# AI Gateway API key (AI_MODE=live only, or rely on Vercel OIDC in production)
# AI_GATEWAY_API_KEY=

# Vercel Blob token (INFRA_MODE=vercel only)
# BLOB_READ_WRITE_TOKEN=

# Optional. Generations allowed per 60 s, per signed-in user and per IP hash. Default: 10
# GENERATION_RATE_LIMIT_PER_MINUTE=

# Optional. Set to "1" automatically by Vercel; never set it yourself. Enforces BotID only when "1".
# VERCEL=

# Optional, unset by default. A caller sending "x-qa-bypass-secret: <value>" skips BotID (QA passes only).
# QA_BYPASS_SECRET=

# "true" pre-fills the sign-in form with the seeded demo account (demo@example.com); off when unset.
# The deployed demo must set it (Vercel environment variables), so a reader can sign in in one click.
DEMO_PREFILL=true
